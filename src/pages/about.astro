---
import BaseLayout from "../layouts/BaseLayout.astro";

const skills = [
  { name: "Linux Server", level: 90, category: "DevOps" },
  { name: "Laravel / PHP", level: 85, category: "Backend" },
  { name: "Docker", level: 80, category: "DevOps" },
  { name: "MySQL / MariaDB", level: 85, category: "Database" },
  { name: "Tailwind CSS", level: 75, category: "Frontend" },
  { name: "Astro", level: 70, category: "Frontend" },
];

const experiences = [
  {
    period: "01/2025 - Present",
    role: "Senior IT Consultant & DevOps Project Leader",
    company: "Digiergy",
    location: "worldwide / remote",
    type: "remote / project-based",
    description:
      "Leading infrastructure teams for enterprise clients in banking, mining, and telecommunications sectors.",
    techStack: ["Docker", "MariaDB", "Nginx", "Linux", "ITSM", "DRP/BCP"],
    achievements: [
      "Led nationwide infrastructure rollout for financial institutions",
      "Architected resilient system solutions for 99.9% uptime",
      "Managed cross-functional teams across 3 industries",
    ],
  },
  {
    period: "01/2023 - 12/2024",
    role: "DevOps Engineer",
    company: "PT Borneo Indobara",
    location: "South Kalimantan, Indonesia",
    type: "remote / project-based",
    description:
      "Improved Fleet Management System (FMS) performance and database reliability for one of Indonesia's largest coal mining operations.",
    techStack: [
      "Docker",
      "MS SQL",
      "MariaDB",
      "Reverse Proxy",
      "Linux",
      "Ubuntu",
      "bash",
      "ActiveMQ",
    ],
    achievements: [
      "Migrated MS SQL to MariaDB with zero data loss",
      "Optimized container resources, reducing server costs and time taken",
      "Installed and configured reverse proxy for production workloads",
    ],
  },
  {
    period: "07/2020 - 12/2022",
    role: "Project Manager (ITSM)",
    company: "CIMB Niaga Bank",
    location: "Jakarta, Indonesia",
    type: "Full-time",
    description:
      "Coordinated User Windows upgrade and installation for approximately 4,000 banking users across Jabodetabek. Managed internal applications, delivery timelines, resources, and technical issue resolution.",
    techStack: [
      "Windows 365",
      "Active Directory",
      "AS/400",
      "Microsoft Endpoint Manager",
      "Manage Engine",
      "PowerShell",
      "Agile",
      "Waterfall",
    ],
    achievements: [
      "Modernized internal enterprise applications to expand functionality, system stability, and user experience for banking personnel",
      "Spearheaded nationwide IT infrastructure rollout, managing Windows 10 upgrades and installations for over 4,000 users across the Greater Jakarta area.",
      "Oversee full project lifecycles, resource allocation, and risk mitigation strategies to ensure on-time delivery across banking division",
    ],
  },
  {
    period: "06/2015 - 06/2020",
    role: "Chief Technology Officer (CTO) & IT Manager",
    company: "PT Azatra Persada Teknologi",
    location: "Jakarta, Indonesia",
    type: "Full-time",
    description:
      "Collaborated with the marketing department to craft new business solutions, Collaborated with the marketing department to craft new business solutions,  ",
    techStack: [, "IT Strategy", "IT Governance", "Agile", "Waterfall"],
    achievements: [
      "Exceeded revenue targets three years in a row and landed a major project that covered one full year of operating expenses.",
    ],
  },
  {
    period: "06/2016 - 12/2018",
    role: "Project Manager (ITSM)",
    company: "Danamon Bank Project - PT. Azatra Persada Teknologi",
    location: "Jakarta, Indonesia",
    type: "project-based / Full-time",
    description:
      "Managed nationwide IT service operations, including helpdesk and support engineers. Handled incident and problem management, ITSM alignment, Disaster Recovery Planning, and Business Continuity Planning.",
    techStack: [
      ,
      "Active Directory",
      "DRP",
      "BCP",
      "AS/400",
      "Agile",
      "Waterfall",
    ],
    achievements: [
      "Directed nationwide IT Service Delivery (SDE) operations, assuring consistent service availability and system uptime across all corporate branche",
      "Managed and standardized endpoint device administration using Microsoft Endpoint Manager (MDE), improving asset visibility and patch compliance company-wide",
      "Oversee full project lifecycles, resource allocation, and risk mitigation strategies to ensure on-time delivery across banking division",
      "Partnered with stakeholders to establish robust Disaster Recovery Planning (DRP) and Business Continuity Planning (BCP) frameworks to ensure maximum system resilience",
    ],
  },
  {
    period: "05/2014 - 06/2016",
    role: "Solutions Engineer",
    company: "PT. Telekomunikasi Indonesia (Enterprise Services Division)",
    location: "Jakarta, Indonesia",
    type: "Full-time",
    description:
      "Conducted competitive analysis for tenders, led contract negotiations, developed technical proposals, and designed business solutions for enterprise clients.",
    techStack: [, "ERP", "CRM", "HRIS", "Agile", "Waterfall"],
    achievements: [
      "Authored technical proposals, solution architectures, and tender specifications tailored to meet high-value enterprise client demands",
      "Conducted competitive market analyses and led complex contract negotiations to secure strategic business wins",
    ],
  },
  {
    period: "12/2011 - 04/2014",
    role: "System Engineer & Database Administrator",
    company: "PT. Astra Graphia Information Technology (AGIT)",
    location: "Jakarta, Indonesia",
    type: "Full-time",
    description:
      "Managed intranet application deployments for Toyota, Daihatsu, and Honda workshop and sales branches, serving approximately 4,000 users. Maintained IIS, Windows AD/DNS, MS Cluster, Hyper-V, SQL Server, SAN storage, and backup systems, while managing Business Continuity and Disaster Recovery Plans (BCP/DRP) and orchestrating regular simulation testing to ensure high availability and operational resilience.",
    techStack: [
      ,
      "ERP",
      "ASP.NET",
      "MS SQL",
      "Crystal Reports",
      "hyper-V",
      "VM-ware",
      "SAN Storage",
      "Backup Systems",
