      "Active Directory",
      "ManageEngine",
      "IIS",
      "LANDesk",
      "SCDPM",
      "DRP",
      "BCP",
    ],
    achievements: [
      "Deployed and configured enterprise intranet applications across 4,000+ users in nationwide Toyota, Daihatsu, and Honda sales and workshop branches",
      "Managed and troubleshot endpoint devices at scale using LANDesk and ManageEngine, standardizing system configuration and improving support response time across branches.",
