---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  category: string;
  author: string;
  tags: string[];
  cover?: string;
  lang?: 'en' | 'id';
}

const {
  title,
  description,
  publishedAt,
  category,
  author,
  tags,
  cover,
  lang = 'en',
} = Astro.props;

const formattedDate = publishedAt.toLocaleDateString(
  lang === 'id' ? 'id-ID' : 'en-US',
  { day: 'numeric', month: 'long', year: 'numeric' }
);

const backUrl = lang === 'id' ? '/id/blog' : '/blog';
const backLabel = lang === 'id' ? '← Kembali ke Blog' : '← Back to Blog';
const byLabel = lang === 'id' ? 'Oleh' : 'By';
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={publishedAt}
  author={author}
  image={cover}
  lang={lang}
>
  <div class="container">
    <article class="post-article">
      <header class="post-header">
        <a href={backUrl} class="back-link">{backLabel}</a>

        <span class="post-category">{category}</span>
        <h1>{title}</h1>
        <p class="post-description">{description}</p>

        <div class="post-meta">
          <span>{byLabel} {author}</span>
          <span>·</span>
          <time datetime={publishedAt.toISOString()}>{formattedDate}</time>
        </div>

        {tags.length > 0 && (
          <div class="post-tags">
            {tags.map(tag => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}
      </header>

      <div class="post-content">
        <slot />
      </div>

      <footer class="post-footer">
        <a href={backUrl} class="btn">{backLabel}</a>
      </footer>
    </article>
  </div>
</BaseLayout>


<style>
  .post-article {
    max-width: 720px;
    margin: 0 auto;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .post-category {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: var(--color-yellow);
    background: var(--color-primary);
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }

  .post-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
  }

  .post-description {
    font-size: 1.15rem;
    color: var(--color-text-muted);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .post-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.9rem;
    color: var(--color-text-muted);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--color-primary);
    background: var(--color-bg-alt);
    padding: 0.2rem 0.7rem;
    border-radius: 6px;
  }

  .post-content {
    font-size: 1.05rem;
    line-height: 1.8;
  }

  .post-content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 1rem;
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
    font-size: 1.35rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(code) {
    background: var(--color-bg-alt);
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.95em;
    color: #be185d;
  }

  .post-content :global(pre) {
    background: #0f172a;
    color: #e2e8f0;
    padding: 1.25rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .post-content :global(pre code) {
    background: none;
    color: inherit;
    padding: 0;
  }

  .post-content :global(blockquote) {
    border-left: 4px solid var(--color-yellow);
    background: var(--color-bg-alt);
    padding: 1rem 1.5rem;
    margin: 1.5rem 0;
    font-style: italic;
  }

  .post-content :global(img) {
    max-width: 100%;
    border-radius: 8px;
    margin: 1.5rem 0;
  }

  .post-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background: var(--color-primary);
    color: white;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .btn:hover {
    background: var(--color-primary-dark);
    color: white;
  }

  @media (max-width: 640px) {
    .post-header h1 {
      font-size: 1.75rem;
    }
  }
</style>